{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/cargo-audit.sh\"",
            "timeout": 120,
            "statusMessage": "Auditing dependencies..."
          }
        ]
      }
    ]
  }
}
