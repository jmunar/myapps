# Database
DATABASE_URL=sqlite://data/myapps.db

# Public URL (used to build callback URIs, etc.)
# Path component becomes the URL prefix (e.g. /myapps)
BASE_URL=http://localhost:3000

# Encryption key for storing sensitive credentials (32-byte hex string)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Web Push notifications (generate with: cargo run -- generate-vapid-keys)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Voice-to-Text (whisper.cpp)
WHISPER_CLI_PATH=whisper-cli
WHISPER_MODELS_DIR=models

# FileClipboard (file sharing between devices)
# Directory holding uploaded files. Point this at a separate mount from the
# database if you can: a full clipboard otherwise stalls every app's SQLite writes.
FILE_CLIPBOARD_DIR=data/file_clipboard
# Default deletion period for new uploads, in days (users can change theirs)
FILE_CLIPBOARD_RETENTION_DAYS=7
# Largest single upload accepted, in bytes (default 5 GiB).
# nginx's client_max_body_size must be at least this large too.
FILE_CLIPBOARD_MAX_FILE_BYTES=5368709120
# Total bytes one user may store, in bytes (default 20 GiB)
FILE_CLIPBOARD_USER_QUOTA_BYTES=21474836480
# Abort uploads that would leave less than this much free disk, in bytes (default 2 GiB)
FILE_CLIPBOARD_MIN_FREE_BYTES=2147483648

# Command Bar (llama.cpp server) — optional, command bar hidden when unset
LLAMA_SERVER_URL=

# Server
BIND_ADDR=127.0.0.1:3000

# Subset of apps to deploy (comma-separated app keys, blank = all)
# Valid keys: leanfin, mindflow, voice_to_text, form_input, notes, file_clipboard
DEPLOY_APPS=

# Auto-seed deployed apps when a user registers via invite (true/false)
SEED=false

# Delete users inactive for this many days (0 = disabled)
CLEANUP_INACTIVE_DAYS=0

# SSO: trusted header from reverse proxy (e.g. Authelia). When set, the app
# trusts this header for authentication and auto-creates users on first visit.
# Example: Remote-User (Authelia default). Leave empty for username/password login.
AUTH_SSO_HEADER=

# External app shortcuts on the launcher (semicolon-separated entries)
# Format: key|name|description|icon|url
# Example: vault|Vaultwarden|Password manager|🔐|https://vault.example.com;cockpit|Cockpit|Server management|🖥️|https://cockpit.example.com:9090
EXTERNAL_APPS=
